{#- Side-by-side comparison. Each item is rendered on its OWN merits (not the whole column at once):
   a multi-line item is CODE → a <pre> that preserves its line breaks and indentation; a plain item is
   a prose point → a clean stacked ROW separated by a hairline rule, NOT a bulleted <li> (bullets read
   poorly for comparisons and mangle code — RICH-1). Deciding per item also means a column may mix code
   and prose without one spoiling the other. #}
{%- set rule = t.color.frame_border if t.color.frame_border else t.color.muted -%}
<div style="display: flex; flex-wrap: wrap; gap: {{ t.space.unit * 2 }}px; margin: 0 0 {{ t.space.unit * 2 }}px 0;">
{%- for col in b.columns %}
<div style="flex: 1; min-width: 220px;">
<div style="font-family: {{ t.type.heading_family }}; font-weight: {{ t.type.heading_weight }}; color: {{ t.color.accent }}; margin-bottom: {{ t.space.unit }}px;">{{ col.title }}</div>
{%- for item in col['items'] %}
{%- if '\n' in item %}
<pre style="background-color: {{ t.color.code_bg }}; color: {{ t.color.code_fg }}; font-family: {{ t.type.mono_family }}; font-size: 13px; line-height: 1.5; padding: {{ t.space.unit }}px {{ t.space.unit + 4 }}px; border-radius: {{ t.shape.radius }}px; overflow-x: auto; margin: 0 0 {{ t.space.unit }}px 0;"><span>{{ item | nl2br }}</span></pre>
{%- else %}
<div style="font-family: {{ t.type.body_family }}; color: {{ t.color.ink }}; line-height: 1.6; padding: {{ t.space.unit }}px 0;{% if not loop.last %} border-bottom: 1px solid {{ rule }};{% endif %}">{{ item | md_inline }}</div>
{%- endif %}
{%- endfor %}
</div>
{%- endfor %}
</div>
