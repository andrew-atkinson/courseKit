<ul style="font-family: {{ t.type.body_family }}; color: {{ t.color.ink }}; line-height: 1.7; list-style-type: none; margin: 0 0 {{ t.space.unit * 2 }}px 0; padding-left: 0;">
{%- for e in b.entries %}
<li style="margin-bottom: {{ t.space.unit }}px; padding-left: 14px; border-left: {{ t.shape.border_width }}px solid {{ t.color.tints.note }};"><strong>{{ e.term }}</strong> <span style="color: {{ t.color.muted }};">—</span> {{ e.definition | md_inline }}</li>
{%- endfor %}
</ul>
